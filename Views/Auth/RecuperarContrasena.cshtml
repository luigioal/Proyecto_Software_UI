@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_AuthLayout";
}


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5 container-contrasena">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h4 class="mb-3 text-center">Recuperar contraseña</h4>

                    <form id="form-recuperar-contrasena">
                        <div class="mb-3">
                            <label for="input-correo" class="form-label">Correo electrónico</label>
                            <input type="email" class="form-control" id="input-correo" name="correo" required />
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Enviar código</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Shared/Utils/FormValidator.js"></script>
    <script src="~/js/Pages/Auth/Contrasena/RecuperarContrasena.js"></script>
}
