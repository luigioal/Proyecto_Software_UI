@{
    ViewData["Title"] = "Mercado";
    Layout = "_AutenticadoLayout";
}

@section Scripts {
    <script src="~/js/Pages/Finanza/Mercado.js"></script>
    
}

@section Styles {
    <link rel="stylesheet" href="~/css/Pages/Finanza/Mercado.css" />
}




<div class="container-fluid py-4">
    <div class="row">
        <!-- Acciones Column -->
        <div class="col-md-6">
            <div class="market-panel">
                <div class="market-header">
                    <h2 class="market-title">Acciones</h2>
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="stocksSortDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            Ordenar por
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="stocksSortDropdown">
                            <li><a class="dropdown-item" href="#" data-sort="name">Nombre</a></li>
                            <li><a class="dropdown-item" href="#" data-sort="symbol">Símbolo</a></li>
                            <li><a class="dropdown-item" href="#" data-sort="price-asc">Precio (menor a mayor)</a></li>
                            <li><a class="dropdown-item" href="#" data-sort="price-desc">Precio (mayor a menor)</a></li>
                        </ul>
                    </div>
                </div>

                <div id="stocks-container">
                    <div class="market-loading">
                        <div class="spinner"></div>
                        <p>Cargando acciones...</p>
                    </div>
                    <!-- Stocks will be dynamically loaded here -->
                </div>
            </div>
        </div>

        <!-- ETFs Column -->
        <div class="col-md-6">
            <div class="market-panel">
                <div class="market-header">
                    <h2 class="market-title">ETFs</h2>
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="etfsSortDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            Ordenar por
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="etfsSortDropdown">
                            <li><a class="dropdown-item" href="#" data-sort="name">Nombre</a></li>
                            <li><a class="dropdown-item" href="#" data-sort="symbol">Símbolo</a></li>
                            <li><a class="dropdown-item" href="#" data-sort="price-asc">Precio (menor a mayor)</a></li>
                            <li><a class="dropdown-item" href="#" data-sort="price-desc">Precio (mayor a menor)</a></li>
                        </ul>
                    </div>
                </div>

                <div id="etfs-container">
                    <div class="market-loading">
                        <div class="spinner"></div>
                        <p>Cargando ETFs...</p>
                    </div>
                    <!-- ETFs will be dynamically loaded here -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Plantilla para cada activo -->
<template id="asset-template">
    <div class="market-asset">
        <div class="asset-info">
            <img class="asset-logo" src="" alt="Logo">
            <div>
                <div class="asset-name"></div>
                <div class="asset-symbol"></div>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <div class="asset-price me-3"></div>
            <button class="btn btn-buy">Comprar</button>
        </div>
    </div>
</template>

<!-- Modal de Compra (implementación básica, se completará después) -->
<div class="modal fade" id="buyModal" tabindex="-1" aria-labelledby="buyModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="buyModalLabel">Comprar Activo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Aquí irá el formulario de compra.</p>
                <div class="mb-3">
                    <label for="quantity" class="form-label">Cantidad</label>
                    <input type="number" class="form-control" id="quantity" min="1" value="1">
                </div>
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="mb-1">Activo: <span id="modal-asset-name"></span></p>
                        <p class="mb-1">Símbolo: <span id="modal-asset-symbol"></span></p>
                    </div>
                    <div>
                        <p class="mb-1">Precio: <span id="modal-asset-price"></span></p>
                        <p class="mb-1">Total: <span id="modal-total-price"></span></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success">Confirmar Compra</button>
            </div>
        </div>
    </div>
</div>