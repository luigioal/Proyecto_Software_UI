@{
    ViewData["Title"] = "Gestión de Balance";
    Layout = "_AutenticadoLayout";
}

@section Scripts {
    <!-- PayPal SDK con configuración mejorada - solo PayPal -->
    <script src="https://www.paypal.com/sdk/js?client-id=AYdCZaz9Uf8TTIf4-wZy_J3UIwQhwc19DuFgck3C7dJ544oSH4gZYXisKdabjAEEOK4MPlnsOwydeG5A&currency=USD&components=buttons"></script>
    <script src="~/js/Pages/Finanza/Balance.js"></script>
}

@section Styles {
    <style>
        .balance-panel {
            background-color: white;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.08);
            width: 95%;
            max-width: 950px;
            position: relative;
            margin: 20px auto;
            padding: 30px;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
        }

        .balance-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .balance-title {
            font-size: 24px;
            font-weight: 500;
            color: #111827;
            margin-bottom: 10px;
        }

        .balance-card {
            background: linear-gradient(135deg, #33384D 0%, #1e2235 100%);
            border-radius: 12px;
            padding: 30px;
            color: white;
            text-align: center;
            margin-bottom: 30px;
            box-shadow: 0 6px 16px rgba(0,0,0,0.15);
        }

        .balance-label {
            font-size: 16px;
            margin-bottom: 10px;
            font-weight: 500;
            opacity: 0.9;
        }

        .balance-amount {
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .operations-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 30px;
        }

        .operation-card {
            background-color: #f9fafb;
            border-radius: 12px;
            padding: 25px;
            border: 1px solid #e5e7eb;
        }

        .operation-title {
            font-size: 18px;
            font-weight: 500;
            color: #111827;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }

            .operation-title i {
                margin-right: 10px;
                font-size: 22px;
            }

        .operation-icon-deposit {
            color: #188754;
        }

        .operation-icon-withdraw {
            color: #dc3545;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: #4b5563;
        }

        .form-control {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: 16px;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .form-control:focus {
                border-color: #33384D;
                box-shadow: 0 0 0 3px rgba(51, 56, 77, 0.15);
                outline: none;
            }

        .btn-operation {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-withdraw {
            background-color: #dc3545;
            color: white;
        }

            .btn-withdraw:hover {
                background-color: #bb2d3b;
            }

        .transactions-section {
            margin-top: 30px;
        }

        .transactions-title {
            font-size: 20px;
            font-weight: 500;
            color: #111827;
            margin-bottom: 15px;
        }

        .transactions-table {
            width: 100%;
            border-collapse: collapse;
        }

            .transactions-table th,
            .transactions-table td {
                padding: 12px 15px;
                text-align: left;
                border-bottom: 1px solid #e5e7eb;
            }

            .transactions-table th {
                background-color: #f9fafb;
                font-weight: 500;
                color: #4b5563;
            }

        .transaction-amount-deposit {
            color: #188754;
            font-weight: 500;
        }

        .transaction-amount-withdraw {
            color: #dc3545;
            font-weight: 500;
        }

        .transaction-fees-details {
            display: flex;
            flex-direction: column;
            font-size: 0.8rem;
            color: #6b7280;
            margin-top: 5px;
        }

        #paypal-button-container {
            margin-top: 20px;
            min-height: 47px;
        }
    </style>
}

<div class="balance-panel">
    <div class="balance-header">
        <h1 class="balance-title">Gestión de Balance</h1>
        <p class="text-muted">Deposita fondos o retira tu dinero de forma segura</p>
    </div>

    <div class="balance-card">
        <div class="balance-label">Balance Disponible</div>
        <div class="balance-amount" id="user-balance">$0.00</div>
        <div class="text-light" id="last-update">Actualizado el: <span id="update-time">--</span></div>
    </div>

    <div class="operations-container">
        <!-- Depósito con PayPal -->
        <div class="operation-card">
            <h2 class="operation-title">
                <i class="bi bi-arrow-down-circle-fill operation-icon-deposit"></i>
                Depositar Fondos
            </h2>

            <form id="deposit-form">
                <div class="form-group">
                    <label for="deposit-amount" class="form-label">Monto a Depositar ($)</label>
                    <input type="number" class="form-control" id="deposit-amount" placeholder="0.00" min="10" step="0.01" required>
                </div>

                <div class="fee-breakdown mt-3 mb-3 p-3" style="background-color: #f8f9fa; border-radius: 8px;">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Monto:</span>
                        <span id="base-amount">$0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Comisión Plataforma:</span>
                        <span id="platform-fee-amount">$0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Comisión Asesor:</span>
                        <span id="advisor-fee-amount">$0.00</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between fw-bold">
                        <span>Total a pagar:</span>
                        <span id="total-amount">$0.00</span>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <div id="paypal-button-container" class="mt-3"></div>
                </div>
            </form>
        </div>

        <!-- Retiro (restaurado) -->
        <div class="operation-card">
            <h2 class="operation-title">
                <i class="bi bi-arrow-up-circle-fill operation-icon-withdraw"></i>
                Retirar Fondos
            </h2>
            <form id="withdraw-form">
                <div class="form-group">
                    <label for="withdraw-amount" class="form-label">Monto a Retirar ($)</label>
                    <input type="number" class="form-control" id="withdraw-amount" placeholder="0.00" min="10" step="0.01" required>
                </div>

                <div class="alert alert-info mt-3">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    Los retiros se procesan en un plazo de 24-48 horas hábiles.
                </div>

                <button type="submit" class="btn-operation btn-withdraw mt-3">Retirar Fondos</button>
            </form>
        </div>
    </div>

  
</div>