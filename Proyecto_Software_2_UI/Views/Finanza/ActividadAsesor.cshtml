@{
    ViewData["Title"] = "Actividad Asesor";
    Layout = "_AutenticadoLayout";
}

@section Scripts {
    <script src="~/js/Pages/Finanza/ActividadAsesor.js"></script>
    <script src="~/js/Pages/Auth/RegistroView/RegistroClienteModal.js"></script>
    <script src="~/js/Shared/Utils/FormValidator.js"></script>
}
@section Styles {
    <link rel="stylesheet" href="~/css/Pages/Finanza/ActividadAsesor.css" />
    <link rel="stylesheet" href="~/css/Pages/Auth/RegistroUsuariosModal.css" />
}

@await Html.PartialAsync("~/Views/Auth/RegistroClienteModal.cshtml")


<div class="dashboard-panel">
    <div class="dashboard-header">
        <div class="dashboard-avatar">
            <img class="dashboard-avatar-img" />
        </div>
        <div class="dashboard-user-info">
            <div class="dashboard-user-name">Nombre de asesor</div>
            <div class="dashboard-user-meta">Asesor desde: 01/01/2024</div>
        </div>
    </div>

    <div class="dashboard-content">
        <div class="dashboard-section">
            <div class="header-title-registro">
                <h2 class="dashboard-section-title">Mis Clientes</h2>
                <button id="btn-registrar" class="user-mgmt-register-button">Registrar</button>
            </div>

            <div class="activity-list">
                <div class="activity-header">
                    <div class="activity-header-label">ID</div>
                    <div class="activity-header-label">Nombre</div>
                    <div class="activity-header-label">Activos</div>
                    <div class="activity-header-label">Último acceso</div>
                    <div class="activity-header-label">Balance</div>
                </div>

                <div class="activity-list-container">
                    <div class="activity-item">
                        <div class="activity-id">001</div>
                        <div class="activity-name">
                            @* <div class="activity-icon"> *@
                            @*     <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"> *@
                            @*         <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" /> *@
                            @*     </svg> *@
                            @* </div> *@
                            <div>Nombre de asesor</div>
                        </div>
                        <div class="activity-value">3 activos</div>
                        <div class="activity-access">01/01/2025</div>
                        <div class="activity-commission">$300</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="performance-section">
            <div class="performance-header">
                <h2 class="performance-title">Rendimientos</h2>
                <div class="performance-dropdown">
                    <select class="performance-select">
                        <option value=""><label>Todos los clientes</label></option>
                        <option value="asesor1">Cliente 1</option>
                        <option value="asesor2">Clientes 2</option>
                        <option value="asesor3">Cliente 3</option>
                    </select>
                </div>
            </div>

            <div class="chart-container">
                <img alt="Gráfico de rendimientos" class="chart-image" />
            </div>
        </div>
    </div>
</div>