
@{
    ViewData["Title"] = "Registrar asesor";
    Layout = "_AuthLayout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h2 class="text-center mb-4">Registrar asesor</h2>

                    <!-- Registro exitoso -->
                    @if (TempData["RegistroExitoso"] != null)
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle-fill me-2"></i>@TempData["RegistroExitoso"]
                        </div>
                    }

                    <!-- Error de registro -->
                    @if (TempData["RegistroError"] != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["RegistroError"]
                        </div>
                    }

                    <form id="registroAsesorForm" data-validacion="auto" enctype="multipart/form-data">
                        <!-- Nombre -->
                        <div class="mb-3">
                            <label for="input-nombre" class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="input-nombre" name="Nombre" required />
                        </div>

                        <!-- Apellidos -->
                        <div class="mb-3">
                            <label for="input-apellido1" class="form-label">Primer Apellido</label>
                            <input type="text" class="form-control" id="input-apellido1" name="Apellido1" required />
                        </div>

                        <div class="mb-3">
                            <label for="input-apellido2" class="form-label">Segundo Apellido</label>
                            <input type="text" class="form-control" id="input-apellido2" name="Apellido2" required />
                        </div>
                        <!-- Fecha de nacimiento -->
                        <div class="mb-3">
                            <label for="input-fecha" class="form-label">Fecha de nacimiento</label>
                            <input type="date" class="form-control" id="input-fecha" name="FechaNacimiento" required />
                        </div>

                        <!-- Correo electrónico -->
                        <div class="mb-3">
                            <label for="input-correo" class="form-label">Correo electrónico</label>
                            <input type="email" class="form-control" id="input-correo" name="CorreoElectronico" required />
                        </div>

                        <!-- Dirección -->
                        <div class="mb-3">
                            <label for="input-direccion" class="form-label">Dirección</label>
                            <input type="text" class="form-control" id="input-direccion" name="Direccion" />
                        </div>

                        <!-- Contraseña -->
                        <div class="mb-3">
                            <label for="input-contrasena" class="form-label">Contraseña</label>
                            <input type="password" class="form-control" id="input-contrasena" name="Contrasena" required />
                        </div>

                        <!-- Foto de perfil -->
                        <div class="mb-4">
                            <label for="input-foto" class="form-label">Foto de perfil</label>
                            <input type="file" class="form-control" id="input-foto" name="FotoPerfil" />
                        </div>

                        <!-- Submit -->
                        <div class="d-grid">
                            <button type="submit" id="btnSubmitRegistro" class="btn btn-success btn-lg">Registrar</button>
                        </div>

                        <!-- Volver a inicio de sesión -->
                        <div class="text-center mt-4">
                            <span>¿Ya tienes una cuenta?</span>
                            <a asp-controller="Auth" asp-action="Login" class="text-decoration-none ms-2">Iniciar sesión</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Shared/Utils/FormValidator.js"></script>
    <script src="~/js/Pages/Auth/RegistroView/RegistroAsesor.js"></script>

}